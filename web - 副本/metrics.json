  "priors": [
    {
      "id": "modality",
      "name": "Modality Coupling Prior",
      "tagline": "Tells the model which channels are speaking — and which are silent.",
      "summary": "FiLM-conditioned per-modality encoder + soft attention that re-normalises across present modalities. Handles modality dropout natively.",
      "math": "α_m = softmax(w_m)·1[modality m present];  z = Σ_m α_m · E_θ(x_m, τ_m)",
      "delta_auc": 0.042
    },
    {
      "id": "topology",
      "name": "Topology Shape Prior",
      "tagline": "Watches the Euler characteristic — recurrence is simply connected, necrosis is full of holes.",
      "summary": "Differentiable surrogate of Euler χ on the bottleneck; pulls predictions toward class-conditional targets via a soft regulariser.",
      "math": "L_χ = Σ_c π_c · (χ̂(z) − χ̄_c)²    with χ̄_R = +4, χ̄_N = −24",
      "delta_auc": 0.028
    },
    {
      "id": "anatomy",
      "name": "Anatomy Spatial Prior",
      "tagline": "Knows where in the brain the lesion sits.",
      "summary": "Lightweight coord-conv that injects a normalised anatomical position grid; biases the model toward the lobe-conditioned class priors observed in EDA.",
      "math": "z' = z ⊕ φ(coord_grid),   with φ a 3×3×3 GroupNorm conv",
      "delta_auc": 0.019
    }
  ],
  "synth_recipes": [
    {"target": "flair", "from": [["t2", 1.0], ["t1", -0.5]], "rationale": "T2-bright with T1 subtraction approximates CSF suppression."},
