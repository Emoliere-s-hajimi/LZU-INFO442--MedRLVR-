      "mitigation": "Flag time-since-RT < 6 mo for radiologist review."
    },
    {
      "id": "mixed_pathology",
      "title": "Mixed pathology (RN border)",
      "summary": "Recurrence nested inside a necrotic cavity. Logits cluster near zero (|logit| < 0.3).",
      "frequency": "~4% of cases (border class)",
      "mitigation": "Output uncertainty; route p ∈ [0.4, 0.6] to MRS or follow-up MRI."
    },
    {
      "id": "single_modality",
      "title": "Only T1 on disk",
      "summary": "Synthesis falls back to mirroring T1; the model still produces a logit, but confidence drops.",
